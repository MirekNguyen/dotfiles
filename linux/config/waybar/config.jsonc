// Waybar - liquid glass bar for Hyprland.
//
// Tracked in the repo and symlinked to ~/.config/waybar.
// The frosted effect comes from the compositor, not from here: see the
// ^waybar$ layer rule in linux/config/hypr/hyprland/rules.lua. Without it this is just a
// translucent bar. Styling lives in style.css.
//
// Module choice is driven by what this machine actually has: no battery module
// (desktop -- /sys/class/power_supply is empty), wifi via NetworkManager, audio
// via PipeWire/WirePlumber, and an active bluetooth controller.
{
  "layer": "top",
  "position": "top",
  "height": 34,

  // Floating bar. The gap is what sells the glass -- a full-width slab reads as
  // a solid panel, whereas an inset rounded bar lets the wallpaper blur around it.
  "margin-top": 12,
  "margin-left": 12,
  "margin-right": 12,
  "spacing": 4,

  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": [],
  // Every item behaves the same way: hover highlights it, left click opens the
  // app behind it, right click is its quick action (mute, play/pause,
  // Bluetooth on/off, Do Not Disturb), scrolling adjusts it where that means
  // something. The window title is plain text, so it has no hover.
  "modules-right": ["custom/media", "custom/volume", "bluetooth", "network", "custom/vpn", "tray", "hyprland/language", "clock", "custom/notification"],

  "hyprland/workspaces": {
    "format": "{name}",
    // Clicking a button does not switch workspaces: waybar 0.15.0 hardcodes
    // the legacy `dispatch workspace N`, which a Lua-configured Hyprland
    // rejects, and the button swallows the click before any on-click runs.
    "sort-by-number": true,
    // r+1/r-1 step numerically (e+1 would skip empty workspaces). Unbounded,
    // so scrolling past 6 creates workspace 7.
    "on-scroll-up": "hyprctl dispatch \"hl.dsp.focus({ workspace = 'r+1' })\"",
    "on-scroll-down": "hyprctl dispatch \"hl.dsp.focus({ workspace = 'r-1' })\"",
    // Hyprland only keeps a workspace alive while it holds windows, so with apps
    // on 1, 2 and 5 the rest do not exist and the module adds/removes buttons as
    // you move around -- the bar reflows and the numbers jump. Declaring 1-6
    // persistent keeps the button set fixed, so positions never change.
    // 7-10 remain bound in Hyprland, just not permanently displayed here.
    "persistent-workspaces": {
      "*": [1, 2, 3, 4, 5, 6]
    }
  },

  "hyprland/window": {
    "format": "{title}",
    "max-length": 60,
    "separate-outputs": true
  },

  // Status in words like the network item; the tunnel names go in the tooltip
  // (second output line). Empty output hides the module.
  "custom/vpn": {
    "interval": 5,
    "exec": "{ ip -br link show type wireguard; ip -br link show type tun; } | awk '{ n = n (n ? \", \" : \"\") $1 } END { if (n) printf \"󰖂  VPN\\n%s\\n\", n }'",
    "on-click": "adwaita-network"
  },

  "custom/media": {
    "format": "{}",
    "max-length": 45,
    "interval": 2,
    // playerctl exits non-zero when nothing is playing; the || keeps waybar
    // from rendering an error string in that case.
    "exec": "playerctl metadata --format '󰎆  {{artist}} – {{title}}' 2>/dev/null || true",
    // Track titles containing & (or < >) are otherwise fed to Pango as markup
    // and fail to render: "Entity did not end with a semicolon". escape makes
    // waybar entity-encode the output first.
    "escape": true,
    // Click raises Spotify, as clicking Now Playing does on macOS.
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ window = \"class:Spotify\" })'",
    "on-click-right": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous",
    "tooltip": false
  },

  // Replaces the built-in wireplumber module: when audio goes out through the
  // UCA202 the real volume lives on the Sonos Beam, which PipeWire knows
  // nothing about. The script keeps running and reports whichever volume
  // actually matters: output switches and key presses show up at once, changes
  // made from the Sonos app within a few seconds.
  "custom/volume": {
    "exec": "~/.config/dotfiles/linux/scripts/sonos-volume.py watch",
    "return-type": "json",
    "restart-interval": 2,
    "on-click": "pwvucontrol",
    "on-click-right": "~/.config/dotfiles/linux/scripts/sonos-volume.py mute",
    "on-scroll-up": "~/.config/dotfiles/linux/scripts/sonos-volume.py up",
    "on-scroll-down": "~/.config/dotfiles/linux/scripts/sonos-volume.py down"
  },

  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-connected": "󰂱  {num_connections}",
    "tooltip-format": "{controller_alias}\n{status}",
    "tooltip-format-connected": "{device_enumerate}",
    // Overskride is GTK4/libadwaita and follows the portal colour-scheme,
    // so it matches the bar in both light and dark mode.
    "on-click": "overskride",
    "on-click-right": "bluetoothctl show | grep -q 'Powered: yes' && bluetoothctl power off || bluetoothctl power on"
  },

  "network": {
    // Status in words, as GNOME and macOS show it; the address is in the tooltip.
    // "linked" is a cable with no address yet, i.e. still getting one.
    "format-wifi": "󰤨  {essid}",
    "format-ethernet": "󰈀  Wired",
    "format-linked": "󰌚  Connecting…",
    "format-disconnected": "󰌙  Not Connected",
    "format-disabled": "󰌙  Network Off",
    "tooltip-format-wifi": "{essid}, {signalStrength}%\n{ipaddr}",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
    "tooltip-format-disconnected": "No network connection",
    "on-click": "adwaita-network"
  },

  "tray": {
    // Same 14px as the symbol icons around it.
    "icon-size": 14,
    "spacing": 10
  },

  "hyprland/language": {
    // EN/CZ, like the input menu on macOS. Ctrl+Space switches (kb_options in
    // linux/config/hypr/hyprland/input.lua); clicking does the same.
    // Must be "{}" when format-<lang> entries exist: waybar fills those in
    // positionally, and a named placeholder fails with "argument not found".
    "format": "{}",
    "format-en": "󰌌  EN",
    "format-cs": "󰌌  CZ",
    "keyboard-name": "xremap",
    "on-click": "hyprctl switchxkblayout all next"
  },

  "clock": {
    // Date and time as macOS shows them: "Thu 22 Oct  22:21". Text only, no
    // icon, like every system clock.
    "format": "{:%a %d %b  %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "format": {
        "today": "<b>{}</b>"
      }
    },
    "on-click": "gnome-calendar"
  },

  // swaync's own waybar integration: -swb emits a JSON stream with the
  // notification count and dnd state, so the icon updates live rather than on a
  // poll interval.
  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "󰂚",
      "none": "󰂜",
      "dnd-notification": "󰂛",
      "dnd-none": "󰂛",
      "inhibited-notification": "󰂚",
      "inhibited-none": "󰂜",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰂛"
    },
    "return-type": "json",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  }
}
