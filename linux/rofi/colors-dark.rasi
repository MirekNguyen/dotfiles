/* Liquid glass - dark. Same values as linux/config/waybar/colors-dark.css.
 * Swapped in by linux/local/share/darkman/theme-switch.sh via the ~/.config/rofi/colors.rasi
 * symlink. Keep the variable names identical to the light variant. */
* {
    bg-base:                    rgba(30, 30, 32, 0.72);
    bg-input:                   rgba(120, 120, 128, 0.24);
    bg-hover:                   rgba(120, 120, 128, 0.36);
    border-glass:               rgba(255, 255, 255, 0.14);
    fg-primary:                 #ffffff;
    fg-secondary:               rgba(235, 235, 245, 0.60);
}
