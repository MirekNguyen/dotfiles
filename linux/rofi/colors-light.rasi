/* Liquid glass - light. Same values as linux/config/waybar/colors-light.css. */
* {
    bg-base:                    rgba(246, 246, 248, 0.72);
    bg-input:                   rgba(120, 120, 128, 0.12);
    bg-hover:                   rgba(120, 120, 128, 0.20);
    border-glass:               rgba(0, 0, 0, 0.10);
    fg-primary:                 #1c1c1e;
    fg-secondary:               rgba(60, 60, 67, 0.60);
}
