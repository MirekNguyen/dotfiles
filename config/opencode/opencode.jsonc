{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [],
  "shell": "/opt/homebrew/bin/fish",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "provider": {
    "litellm-o2cz-public": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM: O2CZ",
      "options": {
        "baseURL": "https://litellm-ai-a-moje.o2.cz/v1",
        "apiKey": "{env:O2_LITELLM_API_KEY}"
      },
      "models": {
        "claude-4.6-sonnet": {
          "name": "Claude 4.6 Sonnet"
        },
        "gemini-3.5-flash": {
          "name": "Gemini 3.5 Flash"
        },
        "deepseek-v4-flash": {
          "name": "Deepseek V4 Flash"
        },
        "deepseek-v4-pro": {
          "name": "Deepseek V4 Pro"
        }
      }
    },
    "deepseek": {
      "models": {
        "deepseek-v4-flash": {
          "limit": {
            "context": 192000,
            "input": 192000,
            "output": 8192
          }
        }
      }
    }
  },
  "mcp": {
    "agent-browser": {
      "type": "local",
      "enabled": false,
      "command": [
        "/opt/homebrew/bin/agent-browser",
        "mcp",
        "--tools",
        "core"
      ],
      "environment": {
        "AGENT_BROWSER_CONFIG": "~/.config/agent-browser/config.json",
        "AGENT_BROWSER_EXECUTABLE_PATH": "/Applications/Helium.app/Contents/MacOS/Helium"
      }
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    },
    "o2-mcp-server": {
      "type": "local",
      "command": [
        "bun",
        "~/.local/projects/temp/o2-mcp/o2-mcp-server/src/index.ts"
      ],
      "enabled": false
    },
    "figma": {
      "type": "local",
      "command": [
        "bunx",
        "-y",
        "figma-developer-mcp",
        "--stdio"
      ],
      "environment": {
        "FIGMA_API_KEY": "{env:FIGMA_API_KEY}"
      },
      "enabled": false
    },
    "dokploy-mcp": {
      "type": "local",
      "command": [
        "bunx",
        "-y",
        "@dokploy/mcp"
      ],
      "environment": {
        "DOKPLOY_URL": "https://app.mirekng.com",
        "DOKPLOY_API_KEY": "{env:DOKPLOY_API_KEY}"
      },
      "enabled": false
    }
  },
  "permission": {
    "external_directory": "allow",
    "read": {
      "*.env*": "allow"
    }
  }
}
