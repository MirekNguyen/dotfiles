#!/usr/bin/env bash
#
# Manage the encrypted secrets store.
#
#   secret add <path> [tier]   encrypt $HOME/<path> into the repo   (tier: personal|work)
#   secret edit <path>         open the decrypted file in $EDITOR, re-encrypt on save
#   secret cat  <path>         print the decrypted contents
#   secret rm   <path>         remove a secret from the repo
#   secret ls                  list everything in the store
#   secret sync                decrypt the whole store back into $HOME
#   secret push [message]      commit + push the repo
#
# <path> is always relative to $HOME, e.g. `.local/secrets/environment`.
#
set -euo pipefail

REPO="${SECRETS_REPO:-$HOME/.config/dotfiles-secrets}"
DOTFILES="${DOTFILES:-$HOME/.config/dotfiles}"
export SOPS_AGE_KEY_FILE="${SOPS_AGE_KEY_FILE:-$HOME/.config/sops/age/keys.txt}"

# sops looks for .sops.yaml relative to the cwd, so point it at the repo
# explicitly - otherwise encryption silently finds no creation rules.
SOPS_CFG=(--config "$REPO/.sops.yaml")

log()  { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
ok()   { printf '\033[1;32m  ok\033[0m %s\n' "$*"; }
die()  { printf '\033[1;31merror:\033[0m %s\n' "$*" >&2; exit 1; }
usage() { awk 'NR==1{next} /^#/{sub(/^# ?/,"");print;next} {exit}' "$0"; exit "${1:-0}"; }

command -v sops >/dev/null || die "sops not installed (nix-rebuild first)"
[ -d "$REPO/.git" ] || die "$REPO not found - run: $DOTFILES/install/setup.sh secrets"
[ -f "$SOPS_AGE_KEY_FILE" ] || die "no age key at $SOPS_AGE_KEY_FILE"

# dotenv files get per-key encryption so `git diff` shows which key changed.
# Everything else is opaque binary.
type_for() {
  case "$(basename "$1")" in
    environment|*.env) printf 'dotenv' ;;
    *)                 printf 'binary' ;;
  esac
}

# Find an existing secret regardless of which tier it lives in.
find_enc() {
  local rel="$1" f
  for f in "$REPO"/*/home/"$rel".enc; do
    [ -e "$f" ] && { printf '%s' "$f"; return 0; }
  done
  return 1
}

cmd="${1:-}"; [ -n "$cmd" ] || usage 1
shift || true

case "$cmd" in

  add)
    rel="${1:-}"; tier="${2:-personal}"
    [ -n "$rel" ] || usage 1
    rel="${rel#$HOME/}"; rel="${rel#/}"
    src="$HOME/$rel"
    [ -e "$src" ] || die "$src does not exist"
    case "$tier" in personal|work) ;; *) die "tier must be 'personal' or 'work'" ;; esac

    if [ -d "$src" ]; then
      # Directories ship as one tarball so member names stay out of the repo.
      dest="$REPO/$tier/home/$rel.tar.enc"
      mkdir -p "$(dirname "$dest")"
      tmp="$(mktemp)"
      tar -czf "$tmp" -C "$(dirname "$src")" "$(basename "$src")"
      sops "${SOPS_CFG[@]}" --input-type binary --output-type binary -e "$tmp" > "$dest"
      rm -f "$tmp"
    else
      it="$(type_for "$src")"
      dest="$REPO/$tier/home/$rel.enc"
      mkdir -p "$(dirname "$dest")"
      sops "${SOPS_CFG[@]}" --input-type "$it" --output-type "$it" -e "$src" > "$dest"
    fi
    ok "encrypted $rel -> ${dest#$REPO/}"
    log "now run: secret push"
    ;;

  edit)
    rel="${1:-}"; [ -n "$rel" ] || usage 1
    rel="${rel#$HOME/}"; rel="${rel#/}"
    enc="$(find_enc "$rel")" || die "no secret for $rel (add it first)"
    # `sops <file>` decrypts to a temp file, opens $EDITOR, re-encrypts on save.
    EDITOR="${EDITOR:-nvim}" sops "${SOPS_CFG[@]}" \
      --input-type "$(type_for "$rel")" --output-type "$(type_for "$rel")" "$enc"
    ok "updated ${enc#$REPO/}"
    log "run: secret push && $DOTFILES/install/setup.sh secrets"
    ;;

  cat)
    rel="${1:-}"; [ -n "$rel" ] || usage 1
    rel="${rel#$HOME/}"; rel="${rel#/}"
    enc="$(find_enc "$rel")" || die "no secret for $rel"
    sops --input-type "$(type_for "$rel")" --output-type "$(type_for "$rel")" -d "$enc"
    ;;

  rm)
    rel="${1:-}"; [ -n "$rel" ] || usage 1
    rel="${rel#$HOME/}"; rel="${rel#/}"
    enc="$(find_enc "$rel")" || die "no secret for $rel"
    rm -f "$enc"
    ok "removed ${enc#$REPO/} (the plaintext at ~/$rel is untouched)"
    ;;

  ls)
    for f in $(find "$REPO"/*/home -type f -name '*.enc' 2>/dev/null | sort); do
      tier="${f#$REPO/}"; tier="${tier%%/*}"
      rel="${f#*/home/}"; rel="${rel%.enc}"
      printf '  %-9s ~/%s\n' "[$tier]" "$rel"
    done
    ;;

  sync)
    exec "$DOTFILES/install/setup.sh" secrets
    ;;

  push)
    cd "$REPO"
    git add -A
    if git diff --cached --quiet; then ok "nothing to commit"; exit 0; fi
    # Refuse to push anything that is not a sops envelope.
    for f in $(git diff --cached --name-only); do
      [ -f "$f" ] || continue            # deletions and renames-away
      case "$f" in *.enc) ;; *) continue ;; esac
      grep -qE '"sops"|sops_version=' "$f" || die "$f is NOT encrypted - aborting"
    done
    git commit -qm "${1:-update secrets}"
    git push -q
    ok "pushed"
    ;;

  -h|--help|help) usage 0 ;;
  *) die "unknown command: $cmd (try --help)" ;;
esac
